# Required for extension build — share links are baked at zip time.
# For local dev, localhost is fine. For prod/demo, use vercel URLs.
# Copy to .env (gitignored) or export in CI: WXT_PUBLIC_WEB_URL / WXT_PUBLIC_REPLAY_SERVER_URL
WXT_PUBLIC_WEB_URL=https://trail-bug.vercel.app
WXT_PUBLIC_REPLAY_SERVER_URL=https://trail-roan.vercel.app

# Local dev alternative (uncomment to use localhost):
# WXT_PUBLIC_WEB_URL=http://localhost:3000
# WXT_PUBLIC_REPLAY_SERVER_URL=http://localhost:8898
