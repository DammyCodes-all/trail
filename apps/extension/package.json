{
  "name": "wxt-react-starter",
  "description": "manifest.json description",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test:page": "node spike/test-page.mjs",
    "verify": "tsc --noEmit && wxt build && node spike/verify.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rrweb": "^2.1.1",
    "rrweb-player": "^2.1.1"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.0.6",
    "@rrweb/types": "^2.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "puppeteer-core": "^25.4.0",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
