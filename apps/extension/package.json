{
  "name": "trail-extension",
  "description": "TRAIL: capture a bug live, turn it into a maintainer-ready GitHub issue.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:page": "node spike/test-page.mjs",
    "verify": "tsc --noEmit && wxt build && node spike/verify.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@base-ui/react": "^1.6.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@trail/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-use-measure": "^2.1.7",
    "rrweb": "^2.1.1",
    "rrweb-player": "^2.1.1",
    "shadcn": "^4.16.1",
    "sileo": "^0.1.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.0.6",
    "@rrweb/types": "^2.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "puppeteer-core": "^25.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
